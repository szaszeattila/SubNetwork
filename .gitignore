__pycache__/
*.pyc

# Generated - rebuild with scripts/build_db.py and scripts/export_graph.py.
db/subnetwork.db
viz/graph.data.js
viz/legacy/graph.data.js

# ~20MB upstream cache; PDSP has no query API, only this bulk export.
db/pdsp_ki_database.csv

# Claude Code session state (worktrees, local settings) - not project content.
.claude/
db/*.db-journal

# Generated by the cohort pipeline - rebuild with scripts/build_cohort.py and
# scripts/export_cohort.py.
db/cohort1.db
db/staging/
db/backups/
viz/gtopdb.data.js
viz/drugcentral.data.js
viz/evidence/
viz/backups/

# Generated by analysis/probe/dump_atc.py - an intermediate, not a source.
analysis/probe/atc_full.json

# Upstream caches for the network backfills (MeSH descriptor file, PubChem
# responses) - re-fetched when missing.
db/cache/

# What scripts/deploy_cloudflare.sh uploaded, one archive per upload.
deploys/

# A rendered copy of a doc, made to annotate in Zotero; the markdown is the record.
docs/HOSTING-REVIEW.pdf
docs/HOSTING-REVIEW-ANSWERS.pdf
